import usp-builder ;

exe x265_encoding_service
: main.cpp
  [ usp-builder.staged-library x265_es_utils ]
  [ usp-builder.staged-library cuti ]
: # On Windows, x265 requires a few registry functions.
  <target-os>windows:<find-shared-library>advapi32
;

explicit uspb-all ;
alias uspb-all : x265_encoding_service ;

explicit uspb-deploy ;
install uspb-deploy
:
  x265_encoding_service
:
  <install-dependencies>off
  <install-type>EXE
  <install-type>PDB
  <conditional>@usp-builder.deploy-exe-location
;

