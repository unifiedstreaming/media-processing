import usp-builder ;

lib x265_es_utils
:
  config.cpp
  encoder_settings.cpp
  encoding_session.cpp
  [ usp-builder.staged-library cuti ]
  [ usp-builder.staged-library x265 ]
  [ usp-builder.staged-library x265_proto ]
  [ usp-builder.staged-library x26x_es_utils ]
:
  <link>static
:
:
  <include>..
;

explicit uspb-all ;
alias uspb-all : x265_es_utils ;

explicit upsb-stage ;
install uspb-stage
:
  x265_es_utils
:
  <install-dependencies>off
  <conditional>@usp-builder.stage-lib-location
;
